# SSDS tiler (TWC super-resolution) — see references/SSDS_API_GUIDE.md
# Copy this file to .env and paste the key in. .env is gitignored; never commit it,
# and never let the key reach the browser bundle (server.js injects it).

SSDS_API_KEY=

# Base URLs. Megapoints/super-res lives under /adaptive; /multipoint is a SIBLING
# of adaptive, not under it. Override only if SSDS moves off qaapi.
SSDS_BASE_URL=https://qaapi.weather.com/v2/tiler

# The adaptive tiler stamps rt ~2 h late (publish time, not model init). We address
# the tiler with its own times and subtract this for display. Set to 0 the day it
# is fixed upstream.
SSDS_RT_OFFSET_HOURS=2
